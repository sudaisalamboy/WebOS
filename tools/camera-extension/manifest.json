{
  "manifest_version": 3,
  "name": "Virtual Camera Injector",
  "version": "1.0",
  "description": "Auto-injects virtual camera on every page \u2014 never stops",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "camera-inject.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "camera-main.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}